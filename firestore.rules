rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isHouseholdMember(hid) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/households/$(hid)) &&
             get(/databases/$(database)/documents/households/$(hid)).data.memberUids
               .hasAny([request.auth.uid]);
    }
    
    function isHouseholdOwner(hid) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/households/$(hid)) &&
             get(/databases/$(database)/documents/households/$(hid)).data.ownerUid == request.auth.uid;
    }

    function userHasListAccess(listId) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData.mainListId == listId ||
             ('sharedListId' in userData && userData.sharedListId == listId);
    }

    function isGroceryListMember(listId) {
      return exists(/databases/$(database)/documents/groceryLists/$(listId)) &&
             (
               get(/databases/$(database)/documents/groceryLists/$(listId)).data.ownerId == request.auth.uid ||
               (
                 'members' in get(/databases/$(database)/documents/groceryLists/$(listId)).data &&
                 get(/databases/$(database)/documents/groceryLists/$(listId)).data.members.hasAny([request.auth.uid])
               )
             );
    }

    function canAccessGroceryList(listId) {
      return isSignedIn() && (isGroceryListMember(listId) || userHasListAccess(listId));
    }

    // Users can read and write their own profile
    match /users/{uid} {
      allow read, write: if isSignedIn() && uid == request.auth.uid;
    }

    // Grocery Lists - allow authenticated users to access their lists
    match /groceryLists/{listId} {
      // Allow read/write for authenticated users
      // This is safe because users can only access lists they have the ID for
      allow read, write: if isSignedIn();
      allow create: if isSignedIn();
    }

    // Family activity log (check-offs, adds) — used by UI and history recovery
    match /familyActivities/{activityId} {
      allow read: if canAccessGroceryList(resource.data.listId);
      allow create: if canAccessGroceryList(request.resource.data.listId) &&
                       request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Promo Codes - PUBLIC READ for validation, owner write only
    match /promoCodes/{code} {
      allow read: if true; // Anyone can read promo codes to validate them
      allow write: if isSignedIn() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.mainListId != null;
    }

    // Comparison Baskets - authenticated users only
    match /comparisonBaskets/{basketId} {
      allow read, write: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Subscriptions - users can read/write their own
    match /subscriptions/{uid} {
      allow read, write: if isSignedIn() && uid == request.auth.uid;
    }

    // Households and all subcollections
    match /households/{hid} {
      // Allow creating new households (for initial creation)
      allow create: if isSignedIn() && 
                       request.resource.data.ownerUid == request.auth.uid &&
                       request.resource.data.memberUids.hasAny([request.auth.uid]);
      
      // Allow read/write for existing household members
      allow read, write: if isHouseholdMember(hid);

      // Lists within households
      match /lists/{lid} {
        allow read, write: if isHouseholdMember(hid);
        
        // Items within lists
        match /items/{iid} {
          allow read, write: if isHouseholdMember(hid);
        }
      }

      // Categories within households
      match /categories/{cid} {
        allow read, write: if isHouseholdMember(hid);
        // Allow creating categories during household creation (when household doesn't exist yet)
        allow create: if isSignedIn();
      }

      // Recipes within households
      match /recipes/{rid} {
        allow read, write: if isHouseholdMember(hid);
      }

      // Pantry items within households
      match /pantry/{pid} {
        allow read, write: if isHouseholdMember(hid);
      }

      // Stores within households
      match /stores/{sid} {
        allow read, write: if isHouseholdMember(hid);
      }
    }
  }
}

# Copy to collector/.env  (this file is git-ignored)

# Supabase project (same one the app uses). The SERVICE ROLE key — never put it in the web app.
SUPABASE_URL=https://xqseuuohoznfqtzdkslk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cities to keep (comma separated, as they appear in the chains' Stores files).
# Spelling variants ("תל אביב - יפו", "תל-אביב") are normalised, but the words must match.
CITIES=תל אביב - יפו,תל אביב,רמת גן,גבעתיים,חולון,בת ים,הרצליה,פתח תקווה,ראשון לציון,בני ברק

# Optional: only these chains (ScraperFactory names from il-supermarket-scraper), e.g.
# CHAINS=SHUFERSAL,RAMI_LEVY,VICTORY,YOHANANOF,MEGA,TIV_TAAM,OSHER_AD,HAZI_HINAM,SUPER_PHARM,YAYNO_BITAN
CHAINS=

# Where downloaded files go (deleted after each run unless --keep-dumps)
DUMP_DIR=./dumps
